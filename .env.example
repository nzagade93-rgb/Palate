# Palate PWA — Environment Variables
# If provided, connects to real-time cloud Supabase Postgres database.
# If omitted, Palate automatically runs in offline-first mode with multi-tab BroadcastChannel sync!

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
